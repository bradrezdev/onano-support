# Backend (apps/api/.env) — values shown are placeholders only.
# Copy this file to apps/api/.env and fill in real values.

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Supabase — get these from your project's Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio — get these from console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Public URL where Twilio webhook callbacks land.
# In dev use ngrok: https://xxxx.ngrok-free.app
WEBHOOK_BASE_URL=